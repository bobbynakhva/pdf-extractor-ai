# Copy to .env and fill in. `docker compose up` reads this file.

# --- Backend ---
# Engaging Mode LLM. Leave all unset to use the deterministic local fallback.
# LLM_PROVIDER=clod            # "clod" | "openai" | "anthropic"

# CLōD (https://clod.io) — OpenAI-compatible gateway, 100 free requests/day.
# CLOD_API_KEY=clod-...
# CLOD_MODEL=DeepSeek V3       # any model name from https://app.clod.io/auth/models
# CLOD_BASE_URL=https://api.clod.io/v1

# OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Restrict CORS if desired (comma-separated). Default: *
# ALLOWED_ORIGINS=https://pdf-extractor-ai.vercel.app

# --- Frontend ---
# URL of the deployed backend. When running on localhost this defaults to
# http://localhost:8000 so you can omit it for local dev.
# NEXT_PUBLIC_API_BASE=https://your-backend.fly.dev
