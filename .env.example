# Copy to .env and fill in. `docker compose up` reads this file.

# --- Backend ---
# Restrict CORS if desired (comma-separated). Default: *
# ALLOWED_ORIGINS=https://pdf-extractor-ai.vercel.app

# Render-cache tunables (optional).
# PDF_RENDER_DPI=150
# RENDER_CACHE_TTL=1800
# RENDER_CACHE_MAX=16

# DOCX export tunables (optional).
# DOCX_JOBS_MAX=32
# DOCX_JOBS_TTL=3600
# DOCX_PDF2DOCX_IDLE_TIMEOUT=120
# DOCX_PDF2DOCX_TOTAL_TIMEOUT=1800

# --- Frontend ---
# URL of the deployed backend. When running on localhost this defaults to
# http://localhost:8000 so you can omit it for local dev.
# NEXT_PUBLIC_API_BASE=https://your-backend.fly.dev
